---
import type { CollectionEntry } from "astro:content";
import ProjectCard from "../ui/card/ProjectCard.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
  title?: string;
}

// No default title: /projects supplies its own heading via HeroSection, so the
// section renders one only when a caller explicitly asks for it.
const { projects = [], title } = Astro.props as Props;
---

<section class="w-full py-10">
  <div class="mx-auto max-w-6xl px-4">
    {title && (
      <h2 class="text-3xl md:text-4xl font-semibold text-center mb-6 text-foreground">{title}</h2>
    )}
    <slot />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projects.map((p) => <ProjectCard entry={p} />)}
    </div>
  </div>
</section>
