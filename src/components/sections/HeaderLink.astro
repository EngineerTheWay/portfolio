---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
const isActive = href === pathname || href === '/' + (subpath?.[0] || '');

// The active link renders bold, which is wider than the resting weight. Without
// reserving that width the whole nav row reflows on every navigation, so the
// links visibly shift as the active one changes. Capturing the label here lets
// the stylesheet lay out a hidden bold copy that holds the wider size open.
const label = (await Astro.slots.render('default')).replace(/<[^>]*>/g, '').trim();
---

<a
	href={href}
	class:list={[className, { active: isActive }]}
	data-label={label}
	{...props}
>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	/* An explicit weight, not `bolder`: `bolder` is relative to the inherited
	   weight, so it would resolve to 700 on a resting link but 900 on one that
	   is already active — reserving the wrong width on exactly the link that
	   needs it to be right. */
	a.active {
		font-weight: 700;
	}
	/* A zero-height, invisible bold copy of the label. It takes no vertical
	   space and cannot be clicked, but it still contributes its width to the
	   inline-block, pinning each link to its bold size in every state. */
	a[data-label]::after {
		content: attr(data-label);
		display: block;
		height: 0;
		overflow: hidden;
		visibility: hidden;
		font-weight: 700;
		pointer-events: none;
		user-select: none;
	}
</style>
