---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
  title?: string;
  minDepth?: number;
  maxDepth?: number;
}

const {
  headings = [],
  title = "On This Page",
  minDepth = 2,
  maxDepth = 3,
} = Astro.props as Props;

const items = headings.filter(
  (h) => h.depth >= minDepth && h.depth <= maxDepth && h.slug && h.text?.trim()
);

// Normalize depth to a 0-based indent level so h2/h3 render consistently
// regardless of which depths a given page actually uses.
const shallowest = items.length ? Math.min(...items.map((h) => h.depth)) : minDepth;
---

{items.length > 1 && (
  <div class="toc-rail">
    <nav class="toc" aria-labelledby="toc-heading" data-toc>
      <p class="toc-title" id="toc-heading">{title}</p>
      <ol class="toc-list" role="list">
        {items.map((h) => (
          <li class={`toc-item toc-level-${h.depth - shallowest}`}>
            <a class="toc-link no-underline" href={`#${h.slug}`} data-toc-link={h.slug}>
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>
)}

<style>
  /* The rail is absolutely positioned against the article body, so it starts
     wherever the layout drops it in the markup rather than floating over
     whatever happens to be at the top of the page (a blog hero image, for
     instance). It spans the full height of that body; the panel inside sticks
     as the reader scrolls through it. */
  .toc-rail {
    display: none;
  }

  /* The article column is 870px wide and centered, so the right gutter is
     (100vw - 870px) / 2. The rail needs 435px (half the column) + 24px gap +
     200px of its own width from centre, plus room before the viewport edge.
     That puts the minimum usable width at ~1358px; 1366px is the nearest real
     laptop resolution. Below it the rail is hidden rather than squeezed. */
  @media (min-width: 1366px) {
    .toc-rail {
      display: block;
      position: absolute;
      top: 0;
      bottom: 0;
      left: calc(100% + 24px);
      width: 200px;
      pointer-events: none;
    }

    .toc {
      position: sticky;
      top: 5rem;
      /* Use the full height available below the sticky offset, leaving a
         margin at the bottom of the viewport. Short lists simply end early;
         only lists that genuinely overflow this height ever scroll. */
      max-height: calc(100vh - 5rem - 2rem);
      display: flex;
      flex-direction: column;
      padding: 0.25rem 0;
      border-left: 1px solid var(--color-border);
      pointer-events: auto;
    }

    /* Only the list scrolls; the heading stays pinned above it. */
    .toc-list {
      flex: 1 1 auto;
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior: contain;

      /* Thin, unobtrusive scrollbar for long tables of contents */
      scrollbar-width: thin;
      scrollbar-color: var(--color-border) transparent;
    }

    .toc-list::-webkit-scrollbar {
      width: 4px;
    }

    .toc-list::-webkit-scrollbar-thumb {
      background: var(--color-border);
      border-radius: 4px;
    }
  }

  .toc-title {
    flex: 0 0 auto;
    margin: 0 0 0.75rem 0;
    padding-left: 0.875rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc-item {
    margin: 0;
    padding: 0;
  }

  .toc-level-1 {
    padding-left: 0.75rem;
  }

  .toc-level-2 {
    padding-left: 1.5rem;
  }

  .toc-link {
    display: block;
    padding: 0.28rem 0 0.28rem 0.875rem;
    line-height: 1.35;
    text-decoration: none;
    border-left: 2px solid transparent;

    /* Resting state: a softened accent, so the list reads as one quiet block
       and the active entry is the only thing at full strength. */
    color: var(--accent);
    color: color-mix(in srgb, var(--accent) 82%, transparent);

    /* Weight alone marks the active entry. Size stays fixed: the column is
       only 200px wide, so scaling text reflowed entries onto extra lines and
       shifted the whole list every time the active heading changed. */
    font-size: 0.8125rem;
    font-weight: 400;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .toc-link[aria-current="true"] {
    font-weight: 700;
    color: var(--accent);
    border-left-color: var(--accent);
  }

  .toc-link:hover,
  .toc-link:focus-visible {
    color: var(--accent);
  }

  .toc-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-link {
      transition: none;
    }
  }
</style>

<script>
  // Torn down and replaced whenever the page is swapped, so repeated
  // initialisation cannot stack duplicate window listeners.
  let teardown: AbortController | null = null;

  function initTableOfContents() {
    teardown?.abort();
    teardown = null;

    const toc = document.querySelector<HTMLElement>("[data-toc]");
    if (!toc) return;

    const controller = new AbortController();
    teardown = controller;
    const { signal } = controller;

    // The list is the scroll container; the heading above it stays pinned.
    const list = toc.querySelector<HTMLElement>(".toc-list");

    const links = Array.from(
      toc.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")
    );
    if (!links.length) return;

    const headings = links
      .map((link) => document.getElementById(link.dataset.tocLink ?? ""))
      .filter((el): el is HTMLElement => el !== null);
    if (!headings.length) return;

    const indexBySlug = new Map(
      links.map((link, i) => [link.dataset.tocLink ?? "", i])
    );

    let activeSlug: string | null = null;
    // Set while a click-to-jump is in flight, so the scroll handler does not
    // fight the smooth scroll by highlighting every heading it passes.
    let lockedSlug: string | null = null;
    let lockTimer: number | undefined;

    function prefersReducedMotion() {
      return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    }

    function setActive(slug: string | null, scrollIntoView = true) {
      if (!slug || slug === activeSlug) return;
      const activeIndex = indexBySlug.get(slug);
      if (activeIndex === undefined) return;
      activeSlug = slug;

      for (const link of links) {
        link.removeAttribute("aria-current");
      }
      const active = links[activeIndex];
      active.setAttribute("aria-current", "true");

      if (!scrollIntoView || !list) return;

      // Keep the active entry visible when the list is taller than the panel,
      // without pulling the page itself around.
      const listBox = list.getBoundingClientRect();
      const linkBox = active.getBoundingClientRect();
      if (linkBox.top < listBox.top || linkBox.bottom > listBox.bottom) {
        const offset =
          linkBox.top - listBox.top - listBox.height / 2 + linkBox.height / 2;
        list.scrollBy({
          top: offset,
          behavior: prefersReducedMotion() ? "auto" : "smooth",
        });
      }
    }

    // The active heading is the last one whose top has passed the activation
    // line near the top of the viewport. Computing it from scratch on every
    // frame keeps fast scrolls, anchor loads, and resizes on the same path —
    // an IntersectionObserver band can be jumped clean over by a fast scroll,
    // which would leave the highlight stranded.
    const ACTIVATION_OFFSET = 120;

    function computeActiveSlug(): string {
      // At the bottom of the page the final sections may be too short to ever
      // reach the activation line, so the last heading wins outright.
      const scrollBottom = window.scrollY + window.innerHeight;
      if (scrollBottom >= document.documentElement.scrollHeight - 2) {
        return headings[headings.length - 1].id;
      }

      let current = headings[0].id;
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top <= ACTIVATION_OFFSET) {
          current = heading.id;
        } else {
          break;
        }
      }
      return current;
    }

    let frame = 0;
    function scheduleUpdate() {
      if (frame) return;
      frame = window.requestAnimationFrame(() => {
        frame = 0;
        if (lockedSlug) return;
        setActive(computeActiveSlug());
      });
    }

    window.addEventListener("scroll", scheduleUpdate, { passive: true, signal });
    window.addEventListener("resize", scheduleUpdate, { passive: true, signal });

    for (const link of links) {
      link.addEventListener(
        "click",
        (event) => {
          const slug = link.dataset.tocLink;
          if (!slug) return;
          const target = document.getElementById(slug);
          if (!target) return;

          event.preventDefault();

          lockedSlug = slug;
          setActive(slug, false);

          target.scrollIntoView({
            behavior: prefersReducedMotion() ? "auto" : "smooth",
            block: "start",
          });

          // Update the URL without triggering the browser's own jump.
          history.replaceState(null, "", `#${slug}`);

          // Make the heading focusable for keyboard and screen reader users so
          // the jump moves the reading position, not just the scroll offset.
          target.setAttribute("tabindex", "-1");
          target.focus({ preventScroll: true });

          window.clearTimeout(lockTimer);
          lockTimer = window.setTimeout(() => {
            lockedSlug = null;
          }, 700);
        },
        { signal }
      );
    }

    // Honour a hash already in the URL on first load, otherwise derive the
    // active entry from wherever the page has been restored to.
    const initial = window.location.hash.slice(1);
    if (initial && indexBySlug.has(initial)) {
      setActive(initial);
    } else {
      setActive(computeActiveSlug(), false);
    }
  }

  initTableOfContents();
  document.addEventListener("astro:page-load", initTableOfContents);
</script>
