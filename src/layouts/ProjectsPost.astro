---
import { Image } from "astro:assets";
import Badge from "../components/ui/badge/Badge.astro";
import Button from "../components/ui/button/Button.astro";
import GlowLineSeparator from '../components/ui/separator/GlowLineSeparator.astro'
import TableOfContents from "../components/ui/toc/TableOfContents.astro";
import type { MarkdownHeading } from "astro";

interface Props {
  title: string;
  description: string;
  techStack?: string | string[];
  icon?: ImageMetadata;
  sourceLink?: string;
  headings?: MarkdownHeading[];
}

const { title, description, techStack, icon, sourceLink, headings = [] } = Astro.props as Props;
---
<head>
        <style>
                /* Align blog layout with site container to avoid right overflow and tight column */
                main {
                    width: 1280px;
                    max-width: calc(100% - 2em);
                    margin: auto;
                    background: var(--color-bg-primary);
                }
            .hero-image {
                width: 100%;
            }
            .hero-image img {
                display: block;
                margin: 0 auto;
                border-radius: 12px;
                box-shadow: var(--box-shadow);
            }
                .prose {
                    width: 100%;
                    max-width: 870px; /* widen column */
                    margin: auto;
                    padding: 0.05em;
                    color: var(--color-text-secondary);
                }
                /* Anchors the table-of-contents rail, which is absolutely
                   positioned into the right gutter. Starting the container
                   below the title block keeps the rail clear of the header. */
                .post-body {
                    position: relative;
                }
            .title {
                margin-bottom: 1em;
                padding: 1em 0;
                text-align: center;
                line-height: 1;
            }
            .title h1 {
                margin: 0 0 0.5em 0;
                color: var(--color-text-primary);
            }
            .date {
                margin-bottom: 0.5em;
                color: var(--color-text-muted);
            }
            .last-updated-on {
                font-style: italic;
            }
        </style>
</head>

<article class="prose mx-auto">
  <h1>{title}</h1>
  <p class="text-lg text-[color:var(--color-text-secondary)]">{description}</p>

  {techStack && (
  <div class="mt-6">
    <span class="inline-flex flex-wrap gap-2 align-middle">
      {(Array.isArray(techStack) ? techStack : [techStack]).map((stack) => (
        <Badge>{stack}</Badge>
      ))}
         {icon && (
         <span class="mx-2 text-[color:var(--color-text-muted)]">|</span>
         <Image src={icon} alt="" width={24} height={24} aria-hidden="true" />
      )}
        {sourceLink && (
          <span class="mx-2 text-[color:var(--color-text-muted)]">|</span>
          <Button
            href={sourceLink}
            variant="secondary"
            size="sm"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="View source code on GitHub"
          >
            <span aria-hidden="true">&lt;</span>
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" class="mx-1.5 shrink-0">
              <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
            </svg>
            <span aria-hidden="true">&gt;</span>
          </Button>
        )}
    </span>
        
    <br>
    <br>
    <GlowLineSeparator />
        
  </div>
)}

  <div class="mt-6 post-body">
    <TableOfContents headings={headings} title="On This Page" />
    <slot />

    <div class="mt-10">
      <a href="/projects" class="sw-btn">← Back to Projects</a>
    </div>
  </div>
</article>
