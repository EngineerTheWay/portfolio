---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/sections/Footer.astro';
import Header from '../components/sections/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import HeroSection from '../components/sections/HeroSection.astro';
import SkillsSection from '../components/sections/SkillsSection.astro';
import { skills } from '../data/skills';
import WorkExperience from '../components/sections/WorkExperience.astro';
import { work } from '../data/work';
import Studies from '../components/sections/Studies.astro';
import { studies } from '../data/studies';
import Carousel from '../components/ui/carousel/Carousel.astro';
import { logos } from '../data/logos';
import { getCollection } from 'astro:content';
import Projects from '../components/sections/Projects.astro';
import ArrowSeparator from '../components/ui/separator/ArrowSeparator.astro'
import GlowLineSeparator from '../components/ui/separator/GlowLineSeparator.astro'

// Top two case studies by priority, shown on the homepage as proof before the
// experience narrative. The full set lives on /projects.
const featuredProjects = (await getCollection('projects'))
  .sort((a, b) => (a.data.priority ?? 999) - (b.data.priority ?? 999))
  .slice(0, 2);

// skills are imported from src/data/skills
---

<!doctype html>
<html lang="en" data-theme="dark" class="dark">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <!-- JSON-LD: Organization -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Caleb Way',
      url: new URL('/', Astro.site).toString(),
      logo: new URL('/favicon.svg', Astro.site).toString(),
      sameAs: [
        'https://github.com/EngineerTheWay',
        'https://www.linkedin.com/in/waycaleb/',
      ],
    })} />
	</head>
	<body>
		<Header />
		<main>
      <HeroSection
        title="Hi, I'm Caleb Way."
        subtitle="Military linguist and intel analyst turned business systems builder. I specialize in building intelligent applications and agentic AI solutions across Microsoft 365, Power Platform and Copilot Studio."
        showCTA
        primaryCTA={{ text: 'View All Projects', href: '/projects' }}
        secondaryCTA={{ text: 'Read Insights', href: '/blog' }}
      />
     

    <section class="py-6">
      <ArrowSeparator />
      <Projects title="Featured Projects" projects={featuredProjects}>
        <div class="mb-6">
          <Carousel tools={logos} />
        </div>
      </Projects>
      <ArrowSeparator />
      <SkillsSection title="Skills" skills={skills} />    
      <ArrowSeparator />
      <WorkExperience title="Professional Experience" items={work} />
      <ArrowSeparator />
      <Studies title="Education" items={studies} />
      <GlowLineSeparator />

    </section>
		</main>
		<Footer />
	</body>
</html>
